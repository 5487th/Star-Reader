#Window{
    background-color: #F5F4F1;
}


#SideBar {
    background-color:#EAE9E5;;
    border-right: 2px solid #D8D7D2;
}

#ThemeToggleButton, #SearchIcon{
    background-color: transparent;
    border: none;
}

#LibraryHeader{
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 32px;
    color: black;
}

#SearchBar{
    background-color: #E3E2DE;;
    border-radius: 6px;
    padding-left: 35px;
    padding-right: 12px;
    color: #000000;
    font-size: 14px;
}


#ImportButton{
    background-color: rgb(223, 225, 227);
    
    border: none;
    border-radius: 10px;
}


#BookCardsScrollArea, #CardGrid{
    background-color: transparent;
   
    border: none;
}


#BookCoverTittle{
    background-color: #EAE9E5;
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 16px;
    color: black; 
    border-radius: 10px;   
}

