#MainMenu {
    background-color: #F5F4F1FF;
}

#SideBar {
    background-color:#EFEFF0FF;
    border-right: 2px solid rgb(223, 225, 227);
}

#SideBarSeparator {
    border-bottom: 2px solid rgb(223, 225, 227);
}

#tabsContainer{
    background-color:  rgb(223, 225, 227);
    border-radius: 10px;
}

#LibraryButton, #FavouritesButton {
    background-color: rgb(208, 210, 212);
    border-radius: 10px;
}

#LibraryButton-disable, #FavouritesButton-disable {
    background-color: none;
    border-radius: none;
}



#LibraryHeader, #FavouriteHeader{
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 32px;
    color: black;
}

#SearchBar{
    background-color: #EFEFF0FF;
    border: 2px solid rgb(223, 225, 227);
    border-radius: 6px;
    padding-left: 35px;
    padding-right: 12px;
    color: #000000;
    font-size: 14px;
}


#ImportButton{
    background-color: rgb(223, 225, 227);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    font-size: large;
    border: none;
    border-radius: 10px;
}

