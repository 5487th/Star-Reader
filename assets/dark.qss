#Window{
    background-color: #11141C;
}

#SideBar{
    background-color:#171B26;
    border-right: 2px solid #161C2AFF;
}

#ThemeToggleButton, #SearchIcon, #BackButton, #PreviousChapterButton, #NextChapterButton {
    background-color: transparent;
    border: none;
}

#LibraryHeader{
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 32px;
    color: white;
}

#SearchBar {
    background-color: #171B26;
    border:none;
    border-radius: 10px;
    padding-left: 35px;
    padding-right: 12px;
    color: #e6e9f5;
    font-size: 14px;
}

#ImportButton {
    background-color: #171B26;
   
    border: none;
    border-radius: 10px;
}

#BookCardsScrollArea, #CardGrid{
    background-color: transparent;
   
    border: none;
}

#BookCoverTittle{
    background-color: #171B26;
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 16px;
    color: white;    
    border-radius: 10px;
}

#TopBarBackground, #BottomBarBackground {
    background-color: #171b26;
    border-radius: 10px;
}

#BookTitle{
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 16px;
    color: white;  
}

#ChapterNumberDisplay{
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 16px;
    color: white; 
}
